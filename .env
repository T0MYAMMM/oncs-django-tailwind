# Scrapyd Integration Environment Configuration
# Copy this file to .env and update the values

# Scrapyd Tracking Database Configuration
# This database contains deployment tracking information from the Scrapyd Generic Crawler
SCRAPYD_DB_ENGINE=postgresql
SCRAPYD_DB_NAME=scrapyd_tracking
SCRAPYD_DB_USER=scrapyd_admin
SCRAPYD_DB_PASS=your_secure_password_here
SCRAPYD_DB_HOST=localhost
SCRAPYD_DB_PORT=5432

# Scrapyd Authentication (if enabled)
# These credentials are used to authenticate with Scrapyd instances
SCRAPYD_USERNAME=scrapyd_admin
SCRAPYD_PASSWORD=onmscrapydadmin        

# Optional: Custom Scrapyd Configuration
# Override default Scrapyd settings if needed
SCRAPYD_DEFAULT_HOST=localhost
SCRAPYD_DEFAULT_PORT=6800
SCRAPYD_HEALTH_CHECK_TIMEOUT=10
SCRAPYD_MAX_RETRIES=3

# Optional: Task Queue Configuration
# Configure task distribution and load balancing
TASK_QUEUE_MAX_PENDING_JOBS=100
TASK_QUEUE_MAX_ERRORS=10
TASK_QUEUE_HEALTH_CHECK_INTERVAL=30
TASK_QUEUE_CLEANUP_DAYS=30

# Optional: Database Connection Settings
# Advanced database configuration
SCRAPYD_DB_OPTIONS_SSLMODE=prefer
SCRAPYD_DB_CONNECTION_TIMEOUT=30
SCRAPYD_DB_POOL_SIZE=10
